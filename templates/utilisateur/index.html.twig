{% extends 'base.html.twig' %}

{% block title %}Créer un nouvel utilisateur
{% endblock %}

{% block body %}
	{% for message in app.flashes('notice') %}
		<div {{ react_component('FlashMessage', props={'message': message } ) }}></div>
	{% endfor %}
	<h1 class="text-white my-5 fs-3 fw-normal text-center">Créer un nouvel utilisateur</h1>
	<div class="container mt-4 d-flex justify-content-center errors-form-li">

		{{ form_start(registrationForm) }}

		<div class="form-group">
			{{ form_label(registrationForm.username, 'Pseudo', {'label_attr': {'class': 'fs-3 fw-normal text-warning'}}) }}
			{{ form_widget(registrationForm.username, {'attr': {'class': 'form-control fs-3 fw-normal border-warning border-2 input-desktop'}}) }}
			{{ form_errors(registrationForm.username) }}
		</div>

		<div class="form-group">
			{{ form_label(registrationForm.prenom, 'Prénom', {'label_attr': {'class': 'fs-3 fw-normal text-warning'}}) }}
			{{ form_widget(registrationForm.prenom, {'attr': {'class': 'form-control fs-3 fw-normal border-warning border-2 input-desktop'}}) }}
			{{ form_errors(registrationForm.prenom) }}
		</div>

		<div class="form-group">
			{{ form_label(registrationForm.password, 'Mot de passe', {'label_attr': {'class': 'fs-3 fw-normal text-warning'}}) }}
			{{ form_widget(registrationForm.password, {'attr': {'class': 'form-control fs-3 fw-normal border-warning border-2 input-desktop'}}) }}
			{{ form_errors(registrationForm.password) }}
		</div>

		<div class="form-group">
			{{ form_label(registrationForm.confirm_password, 'Confirmer le mot de passe', {'label_attr': {'class': 'fs-3 fw-normal text-warning'}}) }}
			{{ form_widget(registrationForm.confirm_password, {'attr': {'class': 'form-control fs-3 fw-normal border-warning border-2 input-desktop'}}) }}
			{{ form_errors(registrationForm.confirm_password) }}
		</div>

		<div class="d-flex justify-content-center">
			<button class="btn btn-outline-warning border-2 rounded-5 my-4" type="submit">
				<span class='fs-3 fw-normal p-2'>Valider</span>
			</button>
		</div>

		{{ form_end(registrationForm) }}
	</div>
{% endblock %}
